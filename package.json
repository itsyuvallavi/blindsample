{
  "name": "cipherquery",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:0g": "ZERO_G_LIVE=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run src/lib/zero-g/client.live.test.ts",
    "test:e2e": "E2E_DIFFICULTY=baseline END_TO_END_LIVE=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run src/lib/api/evaluations.live.test.ts",
    "test:e2e:adversarial": "E2E_DIFFICULTY=adversarial END_TO_END_LIVE=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run src/lib/api/evaluations.live.test.ts",
    "test:e2e:hard": "E2E_DIFFICULTY=hard END_TO_END_LIVE=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run src/lib/api/evaluations.live.test.ts",
    "test:e2e:stress": "E2E_DIFFICULTY=stress END_TO_END_LIVE=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run src/lib/api/evaluations.live.test.ts",
    "test:e2e:full": "E2E_DIFFICULTY=full END_TO_END_LIVE=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run src/lib/api/evaluations.live.test.ts",
    "test:scoring": "SCORING_LIVE=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run src/lib/scoring/score-sample.live.test.ts",
    "test:supabase": "SUPABASE_LIVE=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run src/lib/supabase/evaluations.live.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "csv-parse": "7.0.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
